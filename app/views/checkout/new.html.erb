<% if @lines.empty? %>
  <main class="wrap" style="padding:120px 0;text-align:center">
    <h1 class="display" style="font-size:44px">Your cart is empty</h1>
    <p style="color:var(--muted);margin-top:12px">Add a piece or two before checking out.</p>
    <a href="<%= shop_category_path('bowls') %>" class="btn clay" style="margin-top:26px">Browse the shop <%= icon :arrow, size: 16 %></a>
  </main>
<% else %>
  <%# Online card payment only for countries with a fixed delivery price (and
      when card payments are switched on); everyone else uses the pay-later flow. %>
  <main class="wrap fade-up page-top" data-controller="checkout"
        data-checkout-subtotal-value="<%= @total %>"
        data-checkout-online-value="<%= Mypos.enabled? %>"
        data-checkout-currency-value="<%= ApplicationHelper::CURRENCY %>">
    <%= render "shared/breadcrumb", trail: [["Checkout", nil]] %>
    <h1 class="display checkout-title">Checkout</h1>
    <%= form_with url: checkout_path, method: :post, data: { turbo: false, checkout_target: "form", action: "submit->checkout#guard" } do %>
      <div class="checkout-grid">
        <div>
          <% if flash[:alert] %>
            <div class="checkout-note checkout-alert"><%= flash[:alert] %></div>
          <% end %>
          <div class="checkout-note" data-show="online" hidden>Leave your details, then you'll pay securely by card on the myPOS payment page. Bianna will be in touch about delivery once your payment is through.</div>
          <div class="checkout-note" data-show="offline">No payment is taken here. Leave your details and Bianna will be in touch to confirm your pieces, the total<%= " and delivery cost" if @rates.any? %>, and pickup or delivery.</div>
          <div class="form-stack">
            <label class="field">
              <div class="field-label">Full name</div>
              <input class="input" type="text" name="name" placeholder="Your name" autofocus
                     data-checkout-target="name" data-action="input->checkout#validate">
            </label>
            <div class="contact-grid">
              <label class="field">
                <div class="field-label">Email</div>
                <input class="input" type="email" name="email" placeholder="you@email.com"
                       data-checkout-target="email" data-action="input->checkout#validate">
              </label>
              <label class="field">
                <div class="field-label">Phone</div>
                <input class="input" type="tel" name="phone" placeholder="+43 …"
                       data-checkout-target="phone" data-action="input->checkout#validate">
              </label>
            </div>
            <% if @rates.any? %>
              <label class="field">
                <div class="field-label">Delivery country</div>
                <select class="input" name="country" data-checkout-target="country" data-action="change->checkout#validate">
                  <option value="">Choose your country…</option>
                  <% @rates.each do |r| %>
                    <option value="<%= r.country_code %>" data-cost="<%= r.cost %>"><%= r.name %></option>
                  <% end %>
                  <option value="other">My country isn't listed</option>
                </select>
              </label>
              <label class="field" data-checkout-target="otherField" hidden>
                <div class="field-label">Your country</div>
                <input class="input" type="text" name="country_other" placeholder="Where should we deliver?"
                       data-checkout-target="countryOther" data-action="input->checkout#validate">
                <div class="field-hint">We don't have a set delivery price for your country yet — place your order and Bianna will email you the delivery cost and how to pay.</div>
              </label>
            <% end %>
            <label class="field">
              <div class="field-label">Note for the studio</div>
              <textarea class="input" rows="3" name="note" placeholder="Anything Bianna should know…"></textarea>
              <div class="field-hint">Optional — a gift, a pickup preference, a question.</div>
            </label>
          </div>
        </div>

        <div class="summary">
          <div class="summary-head">Your order</div>
          <div class="summary-lines scroll-thin">
            <% @lines.each do |l| %>
              <div class="summary-line">
                <div class="summary-thumb">
                  <%= media_for(l.record, kind: l.kind, cover: true) %>
                  <span class="summary-qty"><%= l.qty %></span>
                </div>
                <div style="flex:1;min-width:0">
                  <div class="summary-name"><%= l.record.name %><% if l.variant %> <span style="color:var(--muted)">· <%= l.variant.label %></span><% end %></div>
                  <div style="font-size:12px;color:var(--muted)"><%= money l.unit_price %><%= " × #{l.qty}" if l.qty > 1 %></div>
                </div>
                <div class="serif" style="font-size:16px"><%= money l.subtotal %></div>
              </div>
            <% end %>
          </div>
          <% if @rates.any? %>
            <div class="summary-sub-row" style="margin-top:18px"><span>Items</span><span><%= money @total %></span></div>
            <div class="summary-sub-row"><span>Delivery</span><span data-checkout-target="delivery">Choose country</span></div>
          <% end %>
          <div class="summary-total-row">
            <span class="cart-total-label">Total</span>
            <span class="serif" style="font-size:30px" data-checkout-target="total"><%= money @total %></span>
          </div>
          <button type="submit" class="btn clay block" style="margin-top:20px" data-checkout-target="submit" disabled>
            <span data-show="online" hidden>Continue to payment</span><span data-show="offline">Place order</span> <%= icon :arrow, size: 16 %>
          </button>
          <div style="font-size:11.5px;color:var(--faint);margin-top:12px;text-align:center">
            <span data-show="online" hidden>Secure card payment by myPOS.</span><span data-show="offline">You won't be charged now.</span>
          </div>
        </div>
      </div>
    <% end %>

    <% if vacation.active? %>
      <div class="vac-modal" data-checkout-target="modal" hidden>
        <div class="vac-scrim" data-action="click->checkout#cancelOrder"></div>
        <div class="vac-panel">
          <div class="vac-title">Before you order</div>
          <p class="vac-message"><%= vacation.message %></p>
          <div class="vac-actions">
            <button type="button" class="btn ghost" data-action="checkout#cancelOrder">Go back</button>
            <button type="button" class="btn clay" data-action="checkout#confirmOrder">Place order anyway</button>
          </div>
        </div>
      </div>
    <% end %>
  </main>
<% end %>
