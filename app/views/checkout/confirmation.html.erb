<main class="wrap fade-up confirm">
  <div class="confirm-inner">
    <div class="confirm-check">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M5 13l4 4L19 7"/></svg>
    </div>
    <div class="eyebrow clay" style="margin-top:24px"><%= @order.paid? ? "Payment received" : "Order received" %></div>
    <h1 class="display confirm-title">Thank you, <%= @order.customer_name.to_s.split(" ").first %></h1>
    <p class="confirm-lead">
      <% case @order.payment_status %>
      <% when "paid" %>
        Your order <span class="mono clay-text"><%= @order.number %></span> is paid and with the studio. Bianna will email you at
        <strong><%= @order.customer_email %></strong> as soon as it's on its way <%= @order.delivery_phrase %>.
      <% when "pending" %>
        We're still confirming the payment for order <span class="mono clay-text"><%= @order.number %></span> — this usually takes a few seconds.
        <a href="<%= checkout_confirmation_path(@order.number) %>" class="clay-text">Refresh</a> to check. Bianna will email you at
        <strong><%= @order.customer_email %></strong> once it's through.
      <% when "failed" %>
        The payment for order <span class="mono clay-text"><%= @order.number %></span> didn't go through, and nothing was charged.
        <a href="<%= checkout_path %>" class="clay-text">Try again</a>, or write to the studio.
      <% else %>
        Your order <span class="mono clay-text"><%= @order.number %></span> is with the studio. Bianna will email you at
        <strong><%= @order.customer_email %></strong> to confirm the pieces<%= ", the delivery cost to #{@order.country_name}" if @order.delivery_to_quote? %> and how to pay<%= " — then it's sent #{@order.delivery_phrase}" if @order.delivery_priced? %>.
      <% end %>
    </p>
  </div>

  <div class="confirm-summary">
    <div class="confirm-summary-head">
      <span>Summary</span><span class="mono"><%= date_label @order.created_at %></span>
    </div>
    <% @order.order_lines.each do |l| %>
      <div class="confirm-line">
        <span><%= l.display_name %> <span style="color:var(--muted)">× <%= l.qty %></span></span>
        <span class="serif" style="font-size:16px"><%= money l.subtotal %></span>
      </div>
    <% end %>
    <% if @order.delivery_priced? %>
      <div class="confirm-line">
        <span>Delivery <span style="color:var(--muted)">· <%= @order.delivery_label %></span></span>
        <span class="serif" style="font-size:16px"><%= money @order.delivery_cost %></span>
      </div>
    <% elsif @order.country_name.present? %>
      <div class="confirm-line">
        <span>Delivery <span style="color:var(--muted)">· <%= @order.delivery_label %></span></span>
        <span style="color:var(--muted)">quoted by email</span>
      </div>
    <% end %>
    <div style="display:flex;justify-content:space-between;padding:16px 24px;align-items:baseline">
      <span class="cart-total-label">Total</span>
      <span class="serif" style="font-size:28px"><%= money @order.total %></span>
    </div>
  </div>

  <div style="text-align:center;margin-top:36px">
    <a href="<%= root_path %>" class="btn ghost">Back to home</a>
  </div>
</main>
