<% content_for :title, "Preciso — Analytics" %>
<%= render "head", tab: :overview,
      sub: "Real visitors only — #{number_with_delimiter @report.hidden_hits} bot and unverified hits hidden in this range." %>

<div class="admin-pad an-stack">
  <% s = @summary %>
  <div class="stat-grid an-kpis">
    <% [["Visitors", s[:visitors], "likely people"],
        ["Engaged", s[:engaged], "#{pct share(s[:engaged], s[:visitors])} saw 2+ pages"],
        ["Viewed a piece", s[:piece], "#{pct share(s[:piece], s[:visitors])} of visitors"],
        ["Added to cart", s[:cart], "#{pct share(s[:cart], s[:visitors])} of visitors"],
        ["Orders", s[:orders], s[:revenue].positive? ? "#{money s[:revenue]} · #{pct s[:order_rate]} of checkouts" : "#{pct s[:order_rate]} of checkouts"]].each do |label, value, sub| %>
      <div class="stat-card">
        <div class="stat-label"><%= label %></div>
        <div class="stat-value <%= 'accent' if label == 'Orders' %>"><%= number_with_delimiter value %></div>
        <div class="stat-sub"><%= sub %></div>
      </div>
    <% end %>
  </div>

  <section class="chart-card an-chart-card">
    <div class="chart-card-head">
      <h2 class="an-h">How far visitors got · <%= @daily[:step] == 7 ? "each week" : "each day" %></h2>
      <a href="<%= admin_analytics_funnels_path(range: @range) %>" class="an-link">Open purchase funnel →</a>
    </div>
    <p class="an-note">Each bar is the visitors who arrived that <%= @daily[:step] == 7 ? "week" : "day" %>, split by the furthest step they reached.</p>
    <div class="an-legend">
      <% Analytics::Journey::STEPS.each do |k| %>
        <span><i class="an-sw an-sw--<%= k %>"></i><%= Analytics::Journey::OUTCOMES[k] %></span>
      <% end %>
    </div>
    <% max = [1, *@daily[:buckets].map { |b| b[:total] }].max %>
    <div class="an-bars-wrap">
      <div class="an-bars" style="--n:<%= @daily[:buckets].size %>">
        <% @daily[:buckets].each_with_index do |b, i| %>
          <% tip = "#{b[:t].strftime(@daily[:step] == 7 ? 'Week of %b %-d' : '%a %b %-d')} · #{b[:total]} visitors — " +
                   Analytics::Journey::STEPS.reverse.map { |k| "#{b[:counts][k]} #{Analytics::Journey::OUTCOMES[k].downcase}" }.join(", ") %>
          <div class="an-bar" title="<%= tip %>">
            <div class="an-stack-col">
              <% Analytics::Journey::STEPS.each do |k| %>
                <% next if b[:counts][k].zero? %>
                <div class="an-seg an-sw--<%= k %>" style="height:<%= (b[:counts][k].to_f / max * 100).round(2) %>%"></div>
              <% end %>
            </div>
            <div class="an-day"><%= b[:t].day if @daily[:buckets].size <= 14 || i % 3 == 0 %></div>
          </div>
        <% end %>
      </div>
    </div>
  </section>

  <div class="two-col an-two">
    <section class="panel">
      <div class="panel-head"><span>Where visitors come from</span></div>
      <% if @sources.empty? %><div class="empty-state">No visitors in this range yet.</div><% end %>
      <% top = [1, *@sources.map { |r| r[:visitors] }].max %>
      <div class="an-table-wrap">
        <table class="an-table">
          <thead><tr><th>Source</th><th class="num">Visitors</th><th class="num">Engaged</th><th class="num">Carts</th><th class="num">Orders</th></tr></thead>
          <tbody>
            <% @sources.each do |r| %>
              <tr>
                <td><%= r[:name] %><div class="bar-track an-mini"><div class="bar-fill" style="width:<%= (r[:visitors] * 100.0 / top).round %>%"></div></div></td>
                <td class="num"><%= number_with_delimiter r[:visitors] %></td>
                <td class="num muted"><%= r[:engaged] %></td>
                <td class="num muted"><%= r[:cart] %></td>
                <td class="num accent"><%= r[:orders] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="an-foot-note">“Unknown” is traffic recorded before sources were tracked.</p>
    </section>

    <section class="panel">
      <div class="panel-head"><span>Pieces · viewed → carted → ordered</span></div>
      <% if @pieces.empty? %><div class="empty-state">No pieces viewed in this range.</div><% end %>
      <% @pieces.each_with_index do |p, i| %>
        <a href="/<%= p[:key] %>" class="dash-row an-piece" title="View on storefront">
          <span class="dash-row-num"><%= format("%02d", i + 1) %></span>
          <span class="an-piece-name"><%= p[:name] %></span>
          <span class="an-piece-flow"><%= p[:views] %> <i>→</i> <%= p[:carts] %> <i>→</i> <b><%= p[:orders] %></b></span>
        </a>
      <% end %>
      <p class="an-foot-note">Many views and few carts usually means a page needs a better photo, price note or size info.</p>
    </section>
  </div>

  <section class="panel">
    <div class="panel-head"><span>Latest visitors</span><a href="<%= admin_analytics_visitors_path(range: @range) %>" class="an-link">All visitors →</a></div>
    <% if @latest.empty? %><div class="empty-state">No visitors in this range yet.</div><% end %>
    <% @latest.each do |j| %>
      <%= render "visitor_row", j: j %>
    <% end %>
  </section>

  <div class="analytics-foot">
    <div class="note">Counted per browser session with Preciso's own session cookie — no third-party trackers. Crawlers, link previews and pages whose script never ran are left out. Your own admin browsing is never counted.</div>
    <%= button_to "Clear history", admin_reset_analytics_path, method: :delete, class: "clear",
          form: { data: { turbo_confirm: "Clear all analytics history? This cannot be undone." } } %>
  </div>
</div>
