<% content_for :title, "Preciso — Order #{@order.number}" %>
<div class="pagehead">
  <div>
    <h1 class="display pagehead-title">Order <%= @order.number %></h1>
    <p class="pagehead-sub"><%= date_label @order.created_at %> · <%= time_ago @order.created_at %></p>
  </div>
  <div class="pagehead-actions">
    <a href="<%= admin_orders_path %>" class="btn ghost sm"><%= icon :back, size: 16 %> All orders</a>
    <% if (journey_sid = Event.where(label: @order.number).where.not(sid: nil).pick(:sid)) %>
      <a href="<%= admin_analytics_visitor_path(journey_sid, range: "all") %>" class="btn ghost sm">Visitor journey</a>
    <% end %>
  </div>
</div>

<div class="admin-pad dash-grid even" style="align-items:start">
  <div class="panel order-items">
    <div class="panel-head"><span>Items</span></div>
    <% @order.order_lines.each do |l| %>
      <div class="item">
        <div class="order-thumb"><%= media_for(l.record, kind: l.kind, cover: true) if l.record %></div>
        <div style="flex:1">
          <div class="order-line-name"><%= l.display_name %></div>
          <div class="order-line-meta"><%= l.kind == "set" ? "Set" : "Piece" %> · <%= money l.price %> each · <%= line_ready_tag(l.from_stock) %></div>
        </div>
        <div class="order-line-qty">×<%= l.qty %></div>
        <div class="order-line-total"><%= money l.subtotal %></div>
      </div>
    <% end %>
    <% if @order.country_name.present? %>
      <div class="item">
        <div class="order-thumb" style="display:grid;place-items:center;color:var(--muted)"><%= icon :truck %></div>
        <div style="flex:1">
          <div class="order-line-name">Delivery — <%= @order.delivery_label %></div>
          <div class="order-line-meta"><%= @order.delivery_priced? ? "Fixed rate" : "No set rate for this country — quote delivery to the customer" %></div>
        </div>
        <div class="order-line-total"><%= @order.delivery_priced? ? money(@order.delivery_cost) : "—" %></div>
      </div>
    <% end %>
    <div class="order-total-row">
      <span class="cart-total-label">Order total</span>
      <span class="serif" style="font-size:30px"><%= money @order.total %></span>
    </div>
  </div>

  <div class="stack-18">
    <div class="box">
      <div class="box-label">Status</div>
      <div class="status-choices">
        <% Order::STATUS_ORDER.each do |s| %>
          <% meta = Order::STATUSES[s] %>
          <% active = @order.status == s %>
          <%= button_to admin_order_path(@order), method: :patch, params: { status: s },
                class: "status-choice",
                style: active ? "border-color:#{meta[:color]};background:#{meta[:bg]};color:#{meta[:color]}" : "" do %>
            <%= meta[:label] %>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @order.payment_link_possible? %>
      <div class="box">
        <div class="box-label">Confirm & send payment link</div>
        <% if flash[:link_notice] %><div class="subtle-note" style="margin:0 0 10px"><%= flash[:link_notice] %></div><% end %>
        <% if @order.payment_link_sent? %>
          <div class="subtle-note" style="margin:0 0 12px">
            Link sent <%= time_ago @order.payment_link_sent_at %> — waiting for <%= @order.customer_name.to_s.split(" ").first %> to pay <%= money @order.total %>.
            Link: <a href="<%= checkout_pay_url(@order.number) %>" class="mono" style="word-break:break-all"><%= checkout_pay_url(@order.number) %></a>
          </div>
        <% elsif @order.delivery_to_quote? %>
          <div class="subtle-note" style="margin:0 0 12px">No set delivery rate for <strong><%= @order.country_name %></strong>. Check that you can deliver there, then enter the cost — the customer gets an email with the total and a link to pay by card. If you can't deliver, set the order to Cancelled.</div>
        <% else %>
          <div class="subtle-note" style="margin:0 0 12px">No payment was taken for this order. Confirm the delivery cost to email the customer a link to pay by card.</div>
        <% end %>
        <% if Mypos.enabled? %>
          <%= form_with url: send_payment_link_admin_order_path(@order), method: :post,
                data: { turbo_confirm: "Email #{@order.customer_email} a link to pay?" } do %>
            <div class="form-stack" style="gap:12px">
              <label class="field">
                <div class="field-label">Delivery cost (€)</div>
                <%= number_field_tag :delivery_cost, @order.delivery_cost, min: 0, step: 1, required: true, class: "input", placeholder: "e.g. 18" %>
                <div class="field-hint">Pieces <%= money @order.items_total %> + delivery = the amount they pay.</div>
              </label>
              <label class="field">
                <div class="field-label">Message to the customer</div>
                <%= text_area_tag :quote_note, @order.quote_note, rows: 2, class: "input", placeholder: "Optional — e.g. Sent with DHL, arrives in 5–7 days." %>
              </label>
              <button type="submit" class="btn clay sm"><%= icon :mail, size: 16 %> <%= @order.payment_link_sent? ? "Update & resend link" : "Confirm & email payment link" %></button>
            </div>
          <% end %>
        <% else %>
          <div class="subtle-note" style="margin:0">Turn on card payments in <a href="<%= edit_admin_payments_path %>">Payments</a> to send payment links.</div>
        <% end %>
      </div>
    <% end %>

    <div class="box">
      <div class="box-label">Customer</div>
      <div class="kv-list">
        <div class="kv"><span class="k">Name</span><span class="v"><%= @order.customer_name %></span></div>
        <div class="kv"><span class="k">Email</span><span class="v"><a href="mailto:<%= @order.customer_email %>"><%= @order.customer_email %></a></span></div>
        <% if @order.delivery_destination? %>
          <div class="kv"><span class="k"><%= @order.office_delivery? ? "Deliver to office" : "Address" %></span><span class="v"><%= safe_join(@order.delivery_lines, tag.br) %></span></div>
        <% elsif @order.country_name.present? %>
          <div class="kv"><span class="k">Country</span><span class="v"><%= @order.country_name %></span></div>
        <% end %>
        <div class="kv"><span class="k">Phone</span><span class="v"><a href="tel:<%= @order.customer_phone %>"><%= @order.customer_phone %></a></span></div>
        <% if @order.note.present? %>
          <div class="kv"><span class="k">Note</span><span class="v"><%= @order.note %></span></div>
        <% end %>
      </div>
      <% if @order.payment_status == "none" && !@order.payment_link_possible? %>
        <div class="subtle-note">No payment was taken online — contact the customer to arrange payment.</div>
      <% end %>
    </div>

    <div class="box">
      <div class="box-label">Emails</div>
      <% if flash[:notice] %><div class="subtle-note" style="margin:0 0 10px"><%= flash[:notice] %></div><% end %>
      <% logs = @order.email_logs.to_a %>
      <% if logs.empty? %>
        <div class="subtle-note" style="margin-top:0">No emails recorded for this order (orders before 1 Nov 2026 weren't tracked).</div>
      <% else %>
        <div class="email-log">
          <% logs.each do |l| %>
            <div class="email-log-row">
              <div style="min-width:0">
                <div class="email-log-title"><%= l.label %> <span class="email-log-status email-log-<%= l.status %>"><%= l.status %></span></div>
                <div class="email-log-meta"><%= l.recipient.presence || "—" %> · <%= l.created_at.strftime("%-d %b, %H:%M") %><% if l.detail.present? %> · <%= l.detail %><% end %></div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      <div class="email-log-resend">
        <% resendable = [ (@order.paid? ? "paid" : "received"), ("payment_link" if @order.payment_link_sent?), ("status_changed" if OrderMailer::STATUS_EMAILS.include?(@order.status)), "studio_new_order" ].compact %>
        <% resendable.each do |kind| %>
          <%= button_to "Resend: #{EmailLog::KINDS[kind]}", resend_email_admin_order_path(@order, kind: kind), method: :post, class: "btn ghost sm",
                form: { data: { turbo_confirm: "Send the “#{EmailLog::KINDS[kind]}” email again?" } } %>
        <% end %>
      </div>
    </div>

    <% if @order.payment_status.in?(%w[pending paid failed]) %>
      <div class="box">
        <div class="box-label">Payment · myPOS</div>
        <div class="kv-list">
          <div class="kv"><span class="k">Status</span><span class="v"><%= @order.payment_label %></span></div>
          <% if @order.paid_at %>
            <div class="kv"><span class="k">Paid</span><span class="v"><%= date_label @order.paid_at %> · <%= time_ago @order.paid_at %></span></div>
          <% end %>
          <% if @order.payment_details.present? %>
            <div class="kv"><span class="k">Method</span><span class="v"><%= @order.payment_details %></span></div>
          <% end %>
          <% if @order.payment_reference.present? %>
            <div class="kv"><span class="k">myPOS ref</span><span class="v mono"><%= @order.payment_reference %></span></div>
          <% end %>
        </div>
        <% unless @order.paid? %>
          <div class="subtle-note">The customer started checkout but no payment was confirmed. Nothing was charged.</div>
        <% end %>
      </div>
    <% end %>

    <%= button_to admin_order_path(@order), method: :delete, class: "danger-btn",
          form: { data: { turbo_confirm: "Delete this order permanently?" } } do %>
      <%= icon :trash, size: 16 %> Delete order
    <% end %>
  </div>
</div>
