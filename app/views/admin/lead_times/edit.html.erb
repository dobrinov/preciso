<% content_for :title, "Preciso — Lead times" %>
<%= form_with url: admin_lead_times_path, method: :patch, data: { turbo: false } do %>
  <div class="pagehead">
    <div>
      <h1 class="display pagehead-title">Lead times</h1>
      <p class="pagehead-sub">What customers are told about how long pieces take, depending on whether you have them in stock.</p>
    </div>
    <div class="pagehead-actions">
      <button type="submit" class="btn clay sm"><%= icon :check, size: 16 %> Save</button>
    </div>
  </div>

  <div class="admin-pad" style="max-width:640px">
    <div class="card-pad">
      <% if flash[:notice] %>
        <div class="flash-saved fade-up"><%= icon :check, size: 16 %> Saved</div>
      <% end %>

      <label class="field"><div class="field-label">Ready to ship — in stock (“Buy”)</div>
        <%= text_field_tag :ready_note, @lead_time.ready, class: "input" %>
        <div class="field-hint">Shown next to “Ready to ship” on pieces you have in stock.</div>
      </label>

      <label class="field"><div class="field-label">Made to order — not in stock (“Request”)</div>
        <%= text_field_tag :made_note, @lead_time.made, class: "input" %>
        <div class="field-hint">Shown next to “Made to order”, in the cart, at checkout and in order emails.</div>
      </label>

      <div class="subtle-note">Stock itself is set on each piece, variation and set. Customers never see the number — only whether it's ready to ship or made to order.</div>

      <div>
        <button type="submit" class="btn clay"><%= icon :check, size: 16 %> Save changes</button>
      </div>
    </div>
  </div>
<% end %>
