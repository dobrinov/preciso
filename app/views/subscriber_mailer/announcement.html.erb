<% first = @subscriber.name.to_s.split(" ").first %>
<% content_for :preheader, @newsletter.body.to_s.lines.first.to_s.strip.truncate(110) %>
<%= render "order_mailer/hero", eyebrow: "News from the studio",
      headline: @newsletter.subject,
      body: safe_join([(first.present? ? "Hi #{first}," : "Hello,"), tag.br, tag.br, simple_format_inline(@newsletter.body)]) %>

<% if @newsletter.button_url.present? %>
  <%= render "order_mailer/button", label: @newsletter.button_label, url: @newsletter.button_url %>
<% end %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="pad" align="center" style="padding:<%= @newsletter.button_url.present? ? 0 : 10 %>px 56px 30px;font-family:<%= EmailHelper::SANS %>;font-weight:300;font-size:12px;color:<%= EmailHelper::MUTED %>;">
      You're getting this because you asked to hear about new pieces, offers and events from Preciso.
      <a href="<%= @unsubscribe_url %>" style="color:<%= EmailHelper::MUTED %>;">Unsubscribe</a>.
    </td>
  </tr>
</table>
