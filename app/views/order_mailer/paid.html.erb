<% content_for :preheader, "We've received your payment of #{money @order.total} for order #{@order.number}." %>
<%= render "hero", seal: true, eyebrow: "Payment received", headline: "Thank you, #{first_name(@order)}",
      body: safe_join([ "We've received your payment of ", tag.strong(money(@order.total), style: "font-weight:500;"), " for order ", order_number_tag(@order), ". We'll email you as soon as your pieces are on their way #{@order.delivery_phrase}." ]) %>
<%= render "items", order: @order, heading: true, total_label: "Paid", paid_with: paid_with(@order) %>
<%= render "panel", columns: [ ([(@order.office_delivery? ? "Deliver to office" : "Delivering to"), address_html(@order)] if @order.delivery_destination?), ["What happens next", "Bianna prepares and carefully packs your pieces, then sends them #{@order.delivery_phrase}. We'll email you when they're on their way."] ].compact %>
<%= render "button", label: "View your order", url: checkout_confirmation_url(@order.number) %>
