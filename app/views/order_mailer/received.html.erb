<% content_for :preheader, "Order #{@order.number} is with the studio — Bianna will be in touch shortly." %>
<%= render "hero", eyebrow: "Order received", headline: "Thank you, #{first_name(@order)}",
      body: safe_join([ "Your order ", order_number_tag(@order), " is with the studio. Bianna will be in touch shortly to confirm your pieces#{", the delivery cost to #{@order.country_name}" if @order.delivery_to_quote?} and how to pay#{" — then it's sent #{@order.delivery_phrase}" if @order.delivery_priced?}." ]) %>
<%= render "items", order: @order, heading: true %>
<%= render "panel", columns: [ ([(@order.office_delivery? ? "Deliver to office" : "Delivering to"), address_html(@order)] if @order.delivery_destination?), ["Contact", contact_html(@order)] ].compact %>
<%= render "button", label: "View your order", url: checkout_confirmation_url(@order.number) %>
