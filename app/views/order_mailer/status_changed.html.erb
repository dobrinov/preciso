<p>Hi <%= @order.customer_name.to_s.split(" ").first %>,</p>
<% case @order.status %>
<% when "preparing" %>
  <p>Good news — Bianna has started preparing your order <strong><%= @order.number %></strong>.</p>
<% when "fulfilled" %>
  <p>Your order <strong><%= @order.number %></strong> is complete and on its way to you<%= " (or ready for pickup)" unless @order.address_line.present? %>. We hope you enjoy your pieces!</p>
<% when "cancelled" %>
  <p>Your order <strong><%= @order.number %></strong> has been cancelled.<%= " Your payment will be refunded to your card." if @order.paid? %> If you have any questions, just reply to this email.</p>
<% end %>
<%= render "summary", order: @order %>
<p>— Preciso</p>
