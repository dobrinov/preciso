<%# Centered intro: optional check seal, eyebrow, serif headline, body (html). %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td class="pad" align="center" style="padding:52px 56px 36px;text-align:center;">
      <% if local_assigns[:seal] %>
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto 18px;">
          <tr><td align="center" valign="middle" width="54" height="54" style="width:54px;height:54px;border:1px solid #ded8cf;border-radius:27px;background:<%= EmailHelper::PAPER %>;font-family:<%= EmailHelper::SANS %>;font-size:24px;line-height:54px;color:<%= EmailHelper::ACCENT %>;">&#10003;</td></tr>
        </table>
      <% end %>
      <div style="<%= label_style("font-weight:400;letter-spacing:3px;") %>"><%= eyebrow %></div>
      <h1 class="h1" style="margin:16px 0 0;font-family:<%= EmailHelper::SERIF %>;font-weight:400;font-size:44px;line-height:1.08;color:<%= EmailHelper::INK %>;"><%= headline %></h1>
      <p style="margin:16px auto 0;max-width:430px;font-family:<%= EmailHelper::SANS %>;font-weight:300;font-size:15.5px;line-height:1.7;color:<%= EmailHelper::INK_SOFT %>;"><%= body %></p>
    </td>
  </tr>
</table>
