<table width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;margin:20px 0;font-size:14px;">
  <% order.order_lines.each do |l| %>
    <tr>
      <td style="padding:8px 0;border-bottom:1px solid #eee;"><%= l.display_name %> <span style="color:#8a8076;">× <%= l.qty %></span></td>
      <td style="padding:8px 0;border-bottom:1px solid #eee;text-align:right;"><%= money l.subtotal %></td>
    </tr>
  <% end %>
  <% if order.country_name.present? %>
    <tr>
      <td style="padding:8px 0;border-bottom:1px solid #eee;">Delivery · <%= order.country_name %></td>
      <td style="padding:8px 0;border-bottom:1px solid #eee;text-align:right;"><%= order.delivery_priced? ? money(order.delivery_cost) : "to be confirmed" %></td>
    </tr>
  <% end %>
  <tr>
    <td style="padding:12px 0;font-weight:bold;">Total</td>
    <td style="padding:12px 0;text-align:right;font-weight:bold;"><%= money order.total %><%= " + delivery" if order.country_name.present? && !order.delivery_priced? %></td>
  </tr>
</table>
<% if order.address_line.present? %>
  <p style="font-size:14px;color:#5c544c;margin:0 0 16px;">
    <strong>Delivery address</strong><br>
    <%= order.customer_name %><br><%= order.address_line %><br><%= [order.postal_code, order.city].compact_blank.join(" ") %><br><%= order.country_name %>
  </p>
<% end %>
