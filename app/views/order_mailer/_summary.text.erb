<% order.order_lines.each do |l| %>
- <%= l.display_name %> x <%= l.qty %>: <%= money l.subtotal %>
<% end %>
<% if order.country_name.present? %>
- Delivery (<%= order.delivery_label %>): <%= order.delivery_priced? ? money(order.delivery_cost) : "to be confirmed" %>
<% end %>
Total: <%= money order.total %><%= " + delivery" if order.country_name.present? && !order.delivery_priced? %>
<% if order.delivery_destination? %>

Delivery address:
<%= order.customer_name %>
<% order.delivery_lines.each do |line| %>
<%= line %>
<% end %>
<% end %>
